{
  "mcpServers": {
    "openhuman-docs": {
      "type": "http",
      "url": "https://openhuman.readme.io/mcp"
    },
    "git": {
      "type": "stdio",
      "command": "npx",
      "args": ["@modelcontextprotocol/server-git"]
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["@modelcontextprotocol/server-filesystem", "/home/harry"]
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["@modelcontextprotocol/server-github"]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    }
  }
}
